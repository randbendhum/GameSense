APP_NAME="GameSense AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://gsense.humbertorandon.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =========================================================================
# RELATIONAL DATABASE (MySQL 8.0 Tuned for Oracle E2.1.Micro 1GB RAM)
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamesense_ai
DB_USERNAME=gamesense_user
DB_PASSWORD=change_this_strong_password

# =========================================================================
# UNIFIED MYSQL INFRASTRUCTURE (Saves ~100MB RAM by avoiding Redis daemon)
# =========================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=gsai_cache_
CACHE_TTL_SECONDS=604800

# =========================================================================
# AI INTEGRATION — GOOGLE GEMINI
# =========================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=900

# Queue dispatch mode ('async' for Laravel Database Queue or 'sync' for immediate)
GAMESENSE_DISPATCH_MODE=async
